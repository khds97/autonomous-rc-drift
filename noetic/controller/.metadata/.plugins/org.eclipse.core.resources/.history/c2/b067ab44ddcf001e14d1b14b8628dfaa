float adc_to_voltage (uint16_t adc_reading)
{
	float voltage = ((float) (adc_reading) / 4096) * 3.3;

	return voltage;
}

void setVoltage(float voltage, MCP4725* _MCP4725){
	MCP4725_setVoltage(&_MCP4725, voltage, MCP4725_FAST_MODE, MCP4725_POWER_DOWN_OFF);
}

void select_mode(){

	char adc_readings[32] = "";

	if(mode_flag == 0){
		buffer_[0] = adc_to_voltage(adcval[0]);
		buffer_[1] = adc_to_voltage(adcval[1]);
	}

	if(mode_flag == 1){

		//steer = 2.1;

		MCP4725_setVoltage(&myMCP4725_s, steer, MCP4725_FAST_MODE, MCP4725_POWER_DOWN_OFF);
		MCP4725_setVoltage(&myMCP4725_t, throttle, MCP4725_FAST_MODE, MCP4725_POWER_DOWN_OFF);

		buffer_[0] = MCP4725_getVoltage(&myMCP4725_s);
		buffer_[1] = MCP4725_getVoltage(&myMCP4725_t);
	 }

     snprintf(adc_readings, sizeof(adc_readings), "%f\t%d\t%f\t%d\n", buffer_[0], mode_flag, buffer_[1], punishment_flag);

     CDC_Transmit_FS((uint16_t*)adc_readings, strlen(adc_readings));
}

void selectMuxPin(int pin)
{
  for (int i=0; i<3; i++)
  {
    if (pin & (1<<i))
      HAL_GPIO_WritePin(selectpinsPort, selectPins[i], GPIO_PIN_SET);
    else
      HAL_GPIO_WritePin(selectpinsPort, selectPins[i], GPIO_PIN_RESET);
  }
}


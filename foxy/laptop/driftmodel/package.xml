<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>driftmodel</name>
  <version>0.1.0</version>
  <description>Data collection, DAgger training and the vehicle interface of the RC drift car (laptop side, ROS 2 Foxy)</description>

  <maintainer email="ubuntu@todo.todo">ubuntu</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>driftmodel_msg</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <exec_depend>python3-joblib</exec_depend>
  <!-- Not available through rosdep, install with pip: torch, pynput (optional, ESC key to end an episode) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
